	</parameter>
	<parameter name="orderable" class="java.lang.String">
		<property name="displayName" value="Product"/>
		<property name="selectExpression" value="/api/orderables"/>
		<property name="selectProperty" value="id"/>
		<property name="displayProperty" value="fullProductName"/>
		<property name="required" value="false"/>
	</parameter>
	<parameter name="dateFrom" class="java.lang.String">
		<property name="displayName" value="Date From"/>
		<property name="required" value="true"/>
		<parameterDescription><![CDATA[datepickers]]></parameterDescription>
	</parameter>
	<parameter name="dateTo" class="java.lang.String">
		<property name="displayName" value="Date To"/>
		<property name="required" value="true"/>
		<parameterDescription><![CDATA[datepickers]]></parameterDescription>
	</parameter>
	<parameter name="dateFromValue" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{dateFrom} == null ? null : ($P{dateFrom}.matches("\\d{4}-\\d{2}-\\d{2}.*") ? $P{dateFrom}.substring(0, 10) : new SimpleDateFormat("yyyy-MM-dd").format(new SimpleDateFormat("EEE MMM dd yyyy", java.util.Locale.ENGLISH).parse($P{dateFrom})))]]></defaultValueExpression>
	</parameter>
	<parameter name="dateToValue" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{dateTo} == null ? null : ($P{dateTo}.matches("\\d{4}-\\d{2}-\\d{2}.*") ? $P{dateTo}.substring(0, 10) : new SimpleDateFormat("yyyy-MM-dd").format(new SimpleDateFormat("EEE MMM dd yyyy", java.util.Locale.ENGLISH).parse($P{dateTo})))]]></defaultValueExpression>
	</parameter>
	<parameter name="orderableFilter" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[($P{orderable} == null) ? (" ord.id is not NULL") : (" ord.id='"+$P{orderable}+"'::uuid")]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[WITH receipts AS (
    SELECT
        ord.code                             AS product_code,
        ord.fullproductname                  AS product_name,
        COALESCE(src_fac.name, src_org.name) AS received_from,
        lots.lotcode                         AS batch,
        lots.expirationdate                  AS expiration_date,
        SUM(sli.quantity)                    AS quantity_received
    FROM stockmanagement.stock_card_line_items sli
    INNER JOIN stockmanagement.stock_cards sc
        ON sc.id = sli.stockcardid
    INNER JOIN stockmanagement.nodes src
        ON src.id = sli.sourceid
    LEFT JOIN referencedata.facilities src_fac
        ON src.isrefdatafacility IS TRUE
       AND src_fac.id = src.referenceid
    LEFT JOIN stockmanagement.organizations src_org
        ON src.isrefdatafacility IS FALSE
       AND src_org.id = src.referenceid
    INNER JOIN (
        SELECT DISTINCT ON (id)
            id,
            code,
            fullproductname
        FROM referencedata.orderables
        ORDER BY id, versionnumber DESC
    ) ord ON ord.id = sc.orderableid
    INNER JOIN (
        SELECT DISTINCT ON (po.programid, po.orderableid)
            po.programid,
            po.orderableid,
            po.active
        FROM referencedata.program_orderables po
        ORDER BY po.programid, po.orderableid, po.orderableversionnumber DESC
    ) latest_po
        ON latest_po.programid = sc.programid
       AND latest_po.orderableid = sc.orderableid
    LEFT JOIN referencedata.lots lots
        ON lots.id = sc.lotid
    WHERE sc.facilityid = $P{facility}::uuid
      AND sc.programid = $P{program}::uuid
      AND sli.occurreddate BETWEEN $P{dateFromValue}::date AND $P{dateToValue}::date
      AND latest_po.active = TRUE
      AND $P!{orderableFilter}
    GROUP BY
        ord.code,
        ord.fullproductname,
        COALESCE(src_fac.name, src_org.name),
        lots.lotcode,
        lots.expirationdate
)
SELECT
    fac.name  AS facility,
    prog.name AS program,
    COALESCE(
        (SELECT o.fullproductname
         FROM referencedata.orderables o
         WHERE o.id::text = $P{orderable}
         ORDER BY o.versionnumber DESC
         LIMIT 1),
        'All'
    ) AS product_filter,
    r.product_code,
    r.product_name,
    r.received_from,
    r.batch,
    TO_CHAR(r.expiration_date, 'YYYY-MM-DD') AS expiry,
    r.quantity_received
FROM referencedata.facilities fac
CROSS JOIN referencedata.programs prog
LEFT JOIN receipts r ON TRUE
WHERE fac.id = $P{facility}::uuid
  AND prog.id = $P{program}::uuid
ORDER BY
    r.product_code,
    r.received_from,
    r.expiration_date,
    r.batch;]]>
	</queryString>
