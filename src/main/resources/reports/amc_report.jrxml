		<parameterDescription><![CDATA[datepickers]]></parameterDescription>
	</parameter>
	<parameter name="dateFromValue" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{dateFrom} == null ? null : ($P{dateFrom}.matches("\\d{4}-\\d{2}-\\d{2}.*") ? $P{dateFrom}.substring(0, 10) : new SimpleDateFormat("yyyy-MM-dd").format(new SimpleDateFormat("EEE MMM dd yyyy", java.util.Locale.ENGLISH).parse($P{dateFrom})))]]></defaultValueExpression>
	</parameter>
	<parameter name="dateToValue" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{dateTo} == null ? null : ($P{dateTo}.matches("\\d{4}-\\d{2}-\\d{2}.*") ? $P{dateTo}.substring(0, 10) : new SimpleDateFormat("yyyy-MM-dd").format(new SimpleDateFormat("EEE MMM dd yyyy", java.util.Locale.ENGLISH).parse($P{dateTo})))]]></defaultValueExpression>
	</parameter>
	<parameter name="userId" class="java.lang.String" isForPrompting="false"/>
	<queryString language="SQL">
		<![CDATA[WITH RECURSIVE params AS (SELECT $P{program}::uuid AS program_id, $P{supplyingFacility}::uuid AS store_id,
  $P{dateFromValue}::date AS date_from, $P{dateToValue}::date AS date_to, $P{category}::uuid AS category_id,
  $P{orderable}::uuid AS product_id, $P{userId}::uuid AS user_id),

-- Access gate: one row when the caller has STOCK_CARDS_VIEW at the store for the program, no row otherwise.
-- Every step below reads the parameters from here, so without the right every step is empty and no row comes back.
gp AS (
  SELECT p.*
  FROM params p
  WHERE EXISTS (SELECT 1
                FROM referencedata.right_assignments ra
                WHERE ra.userid = p.user_id
                  AND ra.rightname = 'STOCK_CARDS_VIEW'
                  AND ra.facilityid = p.store_id
                  AND ra.programid = p.program_id)
),

-- Candidate products: the latest program_orderables row for the program is active,
-- and the category / product filters match on that row.
po_latest AS (
  SELECT DISTINCT ON (po.programid, po.orderableid)
         po.orderableid, po.active, po.orderabledisplaycategoryid
  FROM referencedata.program_orderables po
  JOIN gp p ON po.programid = p.program_id
  -- An inactive and an active row can share the latest version (the unique index is partial, WHERE active);
  -- the active one wins, as in referencedata.
  ORDER BY po.programid, po.orderableid, po.orderableversionnumber DESC, po.active DESC, po.id
),
prods AS (
  SELECT pl.orderableid, pl.orderabledisplaycategoryid AS category_id
  FROM po_latest pl
  CROSS JOIN gp p
  WHERE pl.active
    AND (p.category_id IS NULL OR pl.orderabledisplaycategoryid = p.category_id)
    AND (p.product_id IS NULL OR pl.orderableid = p.product_id)
),

-- Facilities supplied by the store (option a), resolved the way requisition approval does.
-- Walk up from each requisition group's supervisory node until the first node with a supply line for the program.
prog_groups AS (
  SELECT DISTINCT g.id AS group_id, g.supervisorynodeid AS start_node
  FROM referencedata.requisition_groups g
  JOIN referencedata.requisition_group_program_schedules s ON s.requisitiongroupid = g.id
  JOIN gp p ON s.programid = p.program_id
),
sl_nodes AS (          -- nodes that have at least one supply line for the program
  SELECT DISTINCT sl.supervisorynodeid AS node_id
  FROM referencedata.supply_lines sl
  JOIN gp p ON sl.programid = p.program_id
),
walk (start_node, node_id, path) AS (
  SELECT DISTINCT pg.start_node, pg.start_node, ARRAY[pg.start_node]
  FROM prog_groups pg
  UNION ALL
  SELECT w.start_node, sn.parentid, w.path || sn.parentid
  FROM walk w
  JOIN referencedata.supervisory_nodes sn ON sn.id = w.node_id
  LEFT JOIN sl_nodes stop ON stop.node_id = w.node_id
  WHERE stop.node_id IS NULL             -- this node has no supply line for the program: pass it up
    AND sn.parentid IS NOT NULL          -- no parent: unresolved
    AND sn.parentid <> ALL (w.path)      -- cycle guard
),
store_nodes AS (       -- nodes where ANY supply line for the program comes from the store
  SELECT DISTINCT sl.supervisorynodeid AS node_id
  FROM referencedata.supply_lines sl
  JOIN gp p ON sl.programid = p.program_id AND sl.supplyingfacilityid = p.store_id
),
scope_facilities AS (  -- a walk row on a supply-line node is that walk's first such node (the walk stops there)
  SELECT DISTINCT m.facilityid
  FROM walk w
  JOIN store_nodes st ON st.node_id = w.node_id
  JOIN prog_groups pg ON pg.start_node = w.start_node
  JOIN referencedata.requisition_group_members m ON m.requisitiongroupid = pg.group_id
),

-- Monthly reports in scope, filtered before touching line items.
-- The processing period must lie wholly inside [date_from, date_to]; a period only partly inside does not count.
reqs AS MATERIALIZED (   -- PG12+: guarantees requisitions are filtered before line items are read
  SELECT r.id, r.facilityid
  FROM requisition.requisitions r
  JOIN referencedata.processing_periods pp ON pp.id = r.processingperiodid
  CROSS JOIN gp p
  WHERE r.programid = p.program_id
    AND NOT r.emergency
    AND r.status IN ('AUTHORIZED', 'IN_APPROVAL', 'APPROVED', 'RELEASED', 'RELEASED_WITHOUT_ORDER')
    AND pp.startdate >= p.date_from
    AND pp.enddate <= p.date_to
    AND r.facilityid IN (SELECT sf.facilityid FROM scope_facilities sf)
),
-- Counting lines of the candidate products (any orderable version).
lines AS (
  SELECT q.facilityid, li.orderableid,
         li.totalconsumedquantity AS consumed,
         li.totalstockoutdays     AS stockout,
         li.adjustedconsumption   AS adjusted
  FROM reqs q
  JOIN requisition.requisition_line_items li ON li.requisitionid = q.id
  JOIN prods pr ON pr.orderableid = li.orderableid
  WHERE coalesce(li.skipped, false) = false
    AND coalesce(li.nonfullsupply, false) = false
),
-- Per facility and product. avg() skips NULL adjusted consumption and is NULL when every value is NULL.
-- The ceil per facility is the requisition form's Average consumption (ceil of the mean of the non-NULL
-- adjusted consumptions), here over the facility's reports in the range.
fac AS (
  SELECT l.facilityid, l.orderableid,
         sum(l.consumed)        AS dist,
         sum(l.stockout)        AS stockout_days,
         ceil(avg(l.adjusted))  AS amc
  FROM lines l
  GROUP BY l.facilityid, l.orderableid
),
-- prod_agg, prod_soh and orderable_latest are MATERIALIZED so each runs once. The planner estimates prods at 1 row
-- (its filters compare against the gp CTE) and joins the final SELECT with nested loops; an inlined aggregate there is
-- recomputed per product (2.9 s instead of 0.12 s on the Gambia-size test data).
prod_agg AS MATERIALIZED (   -- one row per product with a counting line; sum() skips NULLs
  SELECT f.orderableid,
         sum(f.dist)          AS dist,
         sum(f.stockout_days) AS stockout_days,
         sum(f.amc)           AS amc
  FROM fac f
  GROUP BY f.orderableid
),

-- Store SOH on date_to: per card, the row with the greatest occurreddate <= date_to
-- (ties: greatest processeddate, then greatest id), summed per product over every lot.
store_cards AS (
  SELECT sc.id AS card_id, sc.orderableid
  FROM stockmanagement.stock_cards sc
  JOIN gp p ON sc.facilityid = p.store_id AND sc.programid = p.program_id
),
card_soh AS (
  SELECT DISTINCT ON (c.stockcardid) c.stockcardid, c.stockonhand
  FROM stockmanagement.calculated_stocks_on_hand c
  JOIN store_cards s ON s.card_id = c.stockcardid
  CROSS JOIN gp p
  WHERE c.occurreddate <= p.date_to
  ORDER BY c.stockcardid, c.occurreddate DESC, c.processeddate DESC, c.id DESC
),
prod_soh AS MATERIALIZED (
  SELECT s.orderableid, sum(cs.stockonhand) AS soh
  FROM store_cards s
  JOIN card_soh cs ON cs.stockcardid = s.card_id
  GROUP BY s.orderableid
),

orderable_latest AS MATERIALIZED (   -- code and name of the highest orderable version
  SELECT DISTINCT ON (o.id) o.id, o.code, o.fullproductname
  FROM referencedata.orderables o
  JOIN prods pr ON pr.orderableid = o.id
  ORDER BY o.id, o.versionnumber DESC
),

-- Row set: a candidate product with a counting line in the range from an in-scope facility,
-- or with a stock card at the store for the program. All numeric columns are non-NULL.
report_rows AS (
  SELECT
    pr.orderableid                       AS orderable_id,
    ol.code                              AS product_code,
    ol.fullproductname                   AS product_name,
    cat.displayname                      AS category,
    coalesce(a.dist, 0)::bigint          AS total_distribution,
    coalesce(a.stockout_days, 0)::bigint AS total_days_out_of_stock,
    coalesce(s.soh, 0)::bigint           AS soh,
    coalesce(a.amc, 0)::bigint           AS amc
  FROM prods pr
  LEFT JOIN prod_agg a          ON a.orderableid = pr.orderableid
  LEFT JOIN prod_soh s          ON s.orderableid = pr.orderableid
  LEFT JOIN orderable_latest ol ON ol.id = pr.orderableid
  LEFT JOIN referencedata.orderable_display_categories cat ON cat.id = pr.category_id
  WHERE a.orderableid IS NOT NULL
     OR EXISTS (SELECT 1 FROM store_cards sc WHERE sc.orderableid = pr.orderableid)
)

-- The selected filter values for the page header, joined to the report rows. When there are no rows (nothing in the
-- range, or no STOCK_CARDS_VIEW right) the LEFT JOIN keeps one row with NULL report columns, so the header and the
-- "no data" message still print. Rows are ordered by category, then product code, then orderable id.
SELECT
  prog.name                            AS program_filter,
  fac.name                             AS facility_filter,
  COALESCE((SELECT c.displayname
            FROM referencedata.orderable_display_categories c
            WHERE c.id = p.category_id), 'All') AS category_filter,
  COALESCE((SELECT o.fullproductname
            FROM referencedata.orderables o
            WHERE o.id = p.product_id
            ORDER BY o.versionnumber DESC
            LIMIT 1), 'All')            AS product_filter,
  rr.orderable_id,
  rr.product_code,
  rr.product_name,
  rr.category,
  rr.total_distribution,
  rr.total_days_out_of_stock,
  rr.soh,
  rr.amc
FROM params p
JOIN referencedata.programs prog   ON prog.id = p.program_id
JOIN referencedata.facilities fac  ON fac.id = p.store_id
LEFT JOIN report_rows rr ON TRUE
ORDER BY rr.category, rr.product_code, rr.orderable_id]]>
	</queryString>
	<field name="program_filter" class="java.lang.String"/>
	<field name="facility_filter" class="java.lang.String"/>
	<field name="category_filter" class="java.lang.String"/>
	<field name="product_filter" class="java.lang.String"/>
	<field name="orderable_id" class="java.util.UUID"/>
	<field name="product_code" class="java.lang.String"/>
	<field name="product_name" class="java.lang.String"/>
	<field name="category" class="java.lang.String"/>
	<field name="total_distribution" class="java.lang.Long"/>
	<field name="total_days_out_of_stock" class="java.lang.Long"/>
	<field name="soh" class="java.lang.Long"/>
	<field name="amc" class="java.lang.Long"/>
