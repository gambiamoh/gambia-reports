			<staticText>
				<reportElement mode="Opaque" x="746" y="0" width="56" height="30" backcolor="#A3EFD8" uuid="b1c2e75b-17c8-48b2-9ad8-f00c06ec0adf"/>
				<box bottomPadding="1" leftPadding="5" rightPadding="3">
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
