	<parameter name="program_name" class="java.lang.String">
		<property name="displayName" value="Program Name"/>
		<property name="selectExpression" value="/api/programs"/>
		<property name="selectProperty" value="id"/>
		<property name="displayProperty" value="name"/>
		<property name="required" value="true"/>
	</parameter>
	<parameter name="supplying_facility" class="java.lang.String">
		<property name="displayName" value="Supplying Facility"/>
		<property name="selectExpression" value="/api/facilities"/>
		<property name="selectProperty" value="id"/>
		<property name="displayProperty" value="name"/>
		<property name="required" value="true"/>
	</parameter>
	<parameter name="category" class="java.lang.String">
		<property name="displayName" value="Category"/>
		<property name="selectExpression" value="/api/orderableDisplayCategories"/>
		<property name="selectProperty" value="id"/>
		<property name="displayProperty" value="displayName"/>
		<property name="required" value="false"/>
	</parameter>
	<parameter name="from_date" class="java.lang.String">
		<property name="displayName" value="Start Date"/>
		<property name="required" value="true"/>
		<parameterDescription><![CDATA[datepickers]]></parameterDescription>
	</parameter>
	<parameter name="to_date" class="java.lang.String">
		<property name="displayName" value="End Date"/>
		<property name="required" value="true"/>
		<parameterDescription><![CDATA[datepickers]]></parameterDescription>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT prog.name AS program_filter,
    fac.name AS facility_filter,
    COALESCE(
        (SELECT c.displayname
         FROM referencedata.orderable_display_categories c
         WHERE c.id = $P{category}::uuid),
        'All'
    ) AS category_filter,
    data.*
FROM referencedata.programs prog
CROSS JOIN referencedata.facilities fac
LEFT JOIN (
SELECT p.name AS program_name,
       p.id AS program_id,
       f.name AS supplying_facility,
       pp.name AS processing_period,
       pp.id AS processing_period_id,
       rf.name AS ordering_facility,
       COUNT(o.id) FILTER (WHERE emergency IS TRUE) AS emergency_count,
       COUNT(o.id) FILTER (WHERE emergency IS FALSE) AS regular_count
FROM fulfillment.orders o
JOIN referencedata.programs p ON p.id = o.programid
JOIN referencedata.facilities f ON f.id = o.supplyingfacilityid
JOIN referencedata.facilities rf ON rf.id = o.facilityid
JOIN referencedata.processing_periods pp ON pp.id = o.processingperiodid
WHERE p.id = $P{program_name}::uuid
  AND f.id = $P{supplying_facility}::uuid
  AND pp.startdate <= $P{to_date}::date
  AND pp.enddate >= $P{from_date}::date
  AND ($P{category} IS NULL OR EXISTS (
      SELECT 1
      FROM fulfillment.order_line_items oli
      JOIN referencedata.program_orderables po
        ON po.programid = o.programid
       AND po.orderableid = oli.orderableid
      WHERE oli.orderid = o.id
        AND po.orderabledisplaycategoryid = $P{category}::uuid))
GROUP BY 1, 2, 3, 4, 5, 6
) data ON TRUE
WHERE prog.id = $P{program_name}::uuid
  AND fac.id = $P{supplying_facility}::uuid
ORDER BY data.program_id, data.processing_period, data.processing_period_id]]>
	</queryString>
